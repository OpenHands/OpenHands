{
  "version": 1,
  "kind": "automation",
  "spec": {
    "name": "QA_K3 Event",
    "trigger": {
      "type": "event",
      "source": "github",
      "on": "pull_request.opened",
      "filter": null,
      "destination": "dispatch_run",
      "subject_key_expr": null,
      "turn_text_expr": null,
      "wake_agent": true
    },
    "enabled": false,
    "prompt": "x",
    "repository": "https://github.com/qa-example/qa-repo",
    "model": null,
    "timeout": 600,
    "branch": "main",
    "plugins": [
      "github:qa-example/qa-plugin"
    ]
  }
}
