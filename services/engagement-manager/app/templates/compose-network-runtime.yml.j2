services:
  {{ project }}-runtime:
    image: {{ runtime_image }}
    networks:
      - {{ network_internal }}
      - {{ network_egress }}
    environment:
      ALLOW_RULES: {{ allow_rules | tojson }}
      DENY_RULES: {{ deny_rules | tojson }}

networks:
  {{ network_internal }}:
    driver: bridge
    internal: true
  {{ network_egress }}:
    driver: bridge
