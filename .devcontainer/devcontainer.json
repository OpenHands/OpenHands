// For format details, see: https://aka.ms/devcontainer.json
{
	"name": "OpenHands",
	"hostRequirements": {
		"cpus": 4,
		"memory": "16gb",
		"storage": "32gb"
	},
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers-extra/features/poetry:2": {}
	},
	"forwardPorts": [3000, 3001],
	"portsAttributes": {
		"3000": {
			"visibility": "public",
			"label": "Backend"
		},
		"3001": {
			"visibility": "public",
			"label": "Frontend"
		},
		"30000-59999": {
			"onAutoForward": "silent",
			"visibility": "public",
			"label": "Agent Container"
		}
	},
	"onCreateCommand": ".devcontainer/prebuild.sh",
	"postCreateCommand": ".devcontainer/setup.sh",
	"postAttachCommand": {
		"openhands": "docker compose -f docker-compose.dev.yml up",
		"claude": "npm install -g @anthropic-ai/claude-code && claude --dangerously-skip-permissions"
	}
}
