# Railway Environment Variables Example
# Copy these to your Railway project's environment variables section
# DO NOT commit this file with actual values

# ============================================
# REQUIRED VARIABLES
# ============================================

# LLM Configuration
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1  # Optional, for custom endpoints

# Security - IMPORTANT: Change this to a random secret!
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Workspace Configuration
WORKSPACE_BASE=/opt/workspace_base
WORKSPACE_MOUNT_PATH=/opt/workspace_base

# File Storage
FILE_STORE=local
FILE_STORE_PATH=/.openhands

# Runtime Configuration (IMPORTANT: See RAILWAY.md for details)
# Railway doesn't support Docker socket - use E2B or Modal instead!
RUNTIME=e2b
E2B_API_KEY=your-e2b-api-key-here
# Or use Modal:
# RUNTIME=modal
# MODAL_API_KEY=your-modal-api-key
# MODAL_SECRET=your-modal-secret

# Sandbox Runtime Container Image
SANDBOX_RUNTIME_CONTAINER_IMAGE=docker.openhands.dev/openhands/runtime:1.2-nikolaik

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Port (Railway provides this automatically, don't set manually)
# PORT=3000

# Debugging
DEBUG=false
DISABLE_COLOR=false

# Agent Configuration
DEFAULT_AGENT=CodeActAgent
MAX_ITERATIONS=500
MAX_BUDGET_PER_TASK=0.0

# Sandbox Configuration
SANDBOX_TIMEOUT=120
SANDBOX_USER_ID=1000
USE_HOST_NETWORK=false

# Security
CONFIRMATION_MODE=false
SECURITY_ANALYZER=llm
ENABLE_SECURITY_ANALYZER=true

# Browser Environment
ENABLE_BROWSER=true

# File Upload Limits
FILE_UPLOADS_MAX_FILE_SIZE_MB=10
FILE_UPLOADS_RESTRICT_FILE_TYPES=false

# History Management
ENABLE_HISTORY_TRUNCATION=true
MAX_CONCURRENT_CONVERSATIONS=3
CONVERSATION_MAX_AGE_SECONDS=864000

# ============================================
# DATABASE (Optional - for persistence)
# ============================================

# Add PostgreSQL service in Railway and link it
# DATABASE_URL will be automatically provided by Railway
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ============================================
# OBSERVABILITY (Optional)
# ============================================

# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token

# ============================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ============================================

# GitHub (for OAuth)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Slack (for notifications)
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# ============================================
# PROVIDER-SPECIFIC CONFIGURATIONS
# ============================================

# For Anthropic/Claude
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your-anthropic-api-key

# For Azure OpenAI
# LLM_MODEL=azure/gpt-4o
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# For Google Gemini
# LLM_MODEL=gemini/gemini-pro
# GEMINI_API_KEY=your-gemini-api-key

# For Ollama (requires hosted Ollama instance)
# LLM_MODEL=ollama/llama2
# OLLAMA_BASE_URL=https://your-ollama-host:11434

# ============================================
# RUNTIME ALTERNATIVES
# ============================================

# E2B Runtime (Recommended for Railway)
# RUNTIME=e2b
# E2B_API_KEY=your-e2b-api-key

# Modal Runtime
# RUNTIME=modal
# MODAL_API_KEY=your-modal-api-key
# MODAL_SECRET=your-modal-secret

# Runloop Runtime
# RUNTIME=runloop
# RUNLOOP_API_KEY=your-runloop-api-key

# Remote Docker (requires secure setup)
# RUNTIME=docker
# DOCKER_HOST=tcp://your-docker-host:2375

# ============================================
# NOTES
# ============================================
#
# 1. Railway automatically provides PORT - don't set it manually
# 2. For production, use PostgreSQL for persistence
# 3. Enable proper security settings (JWT_SECRET, CONFIRMATION_MODE)
# 4. Monitor your LLM usage to control costs
# 5. Use E2B or Modal runtime since Railway doesn't support Docker socket
#
# For detailed setup instructions, see RAILWAY.md
